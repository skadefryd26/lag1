# Backend-konfigurasjon for Bjarne. Kopier denne til .env.local og fyll inn.
# .env.local er ignorert av git og skal ALDRI committes.

# Tilgangstoken til Gjensidiges AI-gateway.
# Kodeagenten henter dette automatisk med az og skriver det hit.
AI_GATEWAY_TOKEN=

# Port backend kjører på (valgfritt).
PORT=3001
